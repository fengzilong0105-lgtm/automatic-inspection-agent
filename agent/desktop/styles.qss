/* ---- Global ---- */
QWidget {
    color: #262626;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#centralRoot, QWidget#pageHost {
    background-color: #F0F2F5;
}

/* ---- Sidebar ---- */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E8ECF0;
}

QPushButton#sidebarBrand {
    background: transparent;
    border: none;
    color: #1890FF;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    padding: 8px 12px;
}

QLabel#sidebarBrand {
    color: #096DD9;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QLabel#sidebarSubtitle {
    color: #8C8C8C;
    font-size: 11px;
    padding-left: 2px;
}

QLabel#sidebarLogo {
    border-radius: 8px;
}

QTextEdit#chatHistory {
    background-color: #FAFBFC;
    border: 1px solid #E8ECF0;
    border-radius: 12px;
    padding: 12px;
}

/* ---- Chat panel header ---- */
QFrame#chatPanelHeader {
    background: transparent;
    border: none;
}

QLabel#chatHeadTitle {
    color: #262626;
    font-size: 13px;
    font-weight: 600;
    padding: 0;
}

QComboBox#chatConvCombo {
    background-color: #FAFBFC;
    border: 1px solid #E8ECF0;
    border-radius: 12px;
    color: #595959;
    font-size: 12px;
    padding: 2px 24px 2px 10px;
    min-height: 24px;
    max-height: 26px;
}

QComboBox#chatConvCombo:focus {
    border: 1px solid #91CAFF;
    background-color: #FFFFFF;
}

QComboBox#chatConvCombo::drop-down {
    border: none;
    width: 20px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}

QPushButton#chatToolbarButton {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 12px;
    color: #262626;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 10px;
    min-height: 24px;
    max-height: 26px;
}

QPushButton#chatToolbarButton:hover {
    color: #1890FF;
    border-color: #91CAFF;
    background-color: #F0F7FF;
}

QComboBox#chatConvCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #E6F4FF;
    selection-color: #1890FF;
}

QLineEdit#chatInput {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 10px;
    min-height: 36px;
    padding: 8px 14px;
}

QPushButton#chatSendButton {
    background-color: #1890FF;
    border: 1px solid #1890FF;
    border-radius: 10px;
    color: #FFFFFF;
    font-weight: 600;
    min-width: 72px;
    min-height: 36px;
}

QPushButton#chatSendButton:hover {
    background-color: #40A9FF;
    border-color: #40A9FF;
    color: #FFFFFF;
}

QLabel#mutedText {
    color: #8C8C8C;
    font-size: 12px;
}

QLabel#actionHelpHint {
    color: #8C8C8C;
    font-size: 9px;
    font-weight: 700;
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 7px;
}

QLabel#actionHelpHint:hover {
    color: #1890FF;
    border-color: #91D5FF;
    background-color: #E6F4FF;
}

QLabel#actionHelpHint[hintVariant="primary"] {
    color: #1890FF;
    background-color: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 0.85);
}

QLabel#actionHelpHint[hintVariant="primary"]:hover {
    color: #096DD9;
    background-color: #FFFFFF;
    border-color: #91D5FF;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #595959;
    text-align: left;
    padding: 10px 14px;
    min-height: 40px;
}

QPushButton#navButton:hover {
    background-color: #F5F7FA;
    color: #262626;
}

QPushButton#navButton:checked {
    background-color: #1890FF;
    color: #FFFFFF;
    font-weight: 600;
    border-left: none;
    padding-left: 14px;
}

QLabel#sidebarVersion {
    color: #BFBFBF;
    font-size: 11px;
    padding: 8px 12px 4px 12px;
}

/* ---- Top bar ---- */
QWidget#topBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8ECF0;
}

QLabel#pageTitle {
    font-size: 18px;
    font-weight: 600;
    color: #262626;
}

QLabel#fieldLabel, QLabel#sectionLabel {
    color: #8C8C8C;
    font-size: 12px;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #262626;
}

QLabel#statTitle {
    color: #8C8C8C;
    font-size: 12px;
}

QLabel#statValue {
    color: #262626;
    font-size: 28px;
    font-weight: 600;
}

QLabel#statHint {
    color: #8C8C8C;
    font-size: 12px;
}

/* Stat cards — accent colors (property-based) */
QFrame#card[accent="primary"] QLabel#statValue { color: #1890FF; }
QFrame#card[accent="success"] {
    background-color: #F6FFED;
    border: 1px solid #B7EB8F;
    border-left: 4px solid #52C41A;
}
QFrame#card[accent="success"] QLabel#statValue { color: #389E0D; font-size: 32px; font-weight: 700; }
QFrame#card[accent="success"] QLabel#statTitle { color: #389E0D; }

QFrame#card[accent="danger"] {
    background-color: #FFF2F0;
    border: 1px solid #FFCCC7;
    border-left: 4px solid #FF4D4F;
}
QFrame#card[accent="danger"] QLabel#statValue { color: #CF1322; font-size: 32px; font-weight: 700; }
QFrame#card[accent="danger"] QLabel#statTitle { color: #CF1322; }

QFrame#card[accent="warning"] QLabel#statValue { color: #D48806; }
QFrame#card[accent="warning"] {
    background-color: #FFFBE6;
    border: 1px solid #FFE58F;
    border-left: 4px solid #FAAD14;
}

QFrame#card[clickable="true"]:hover {
    border-color: #91CAFF;
}
QFrame#card[accent="success"][clickable="true"]:hover {
    background-color: #EFFFDB;
    border-color: #52C41A;
}
QFrame#card[accent="danger"][clickable="true"]:hover {
    background-color: #FFECE8;
    border-color: #FF4D4F;
}

/* ---- Cards ---- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 12px;
}

QFrame#confirmBanner {
    background-color: #FFF7E6;
    border: 1px solid #FFD591;
    border-radius: 12px;
}

QLabel#confirmTitle {
    color: #D46B08;
    font-size: 15px;
    font-weight: 700;
}

QLabel#confirmSubtitle {
    color: #8C8C8C;
    font-size: 12px;
}

QLabel#confirmDetail {
    color: #595959;
    font-size: 13px;
}

QLabel#confirmCommand {
    background-color: #1F1F1F;
    color: #FAFAFA;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 12px;
    border-radius: 8px;
    padding: 12px 14px;
}

QLabel#confirmHost {
    color: #8C8C8C;
    font-size: 12px;
}

QPushButton#confirmRejectButton {
    background-color: #FFFFFF;
    border: 1px solid #FFA940;
    border-radius: 8px;
    color: #D46B08;
    font-weight: 600;
    min-height: 36px;
    padding: 6px 18px;
}

QPushButton#confirmRejectButton:hover {
    background-color: #FFF7E6;
    border-color: #FA8C16;
    color: #D46B08;
}

QPushButton#confirmAcceptButton {
    background-color: #1890FF;
    border: 1px solid #1890FF;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 36px;
    min-width: 120px;
    padding: 6px 22px;
}

QPushButton#confirmAcceptButton:hover {
    background-color: #40A9FF;
    border-color: #40A9FF;
    color: #FFFFFF;
}

QPushButton#confirmAcceptButton:disabled {
    background-color: #F0F0F0;
    border-color: #E8E8E8;
    color: #BFBFBF;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 8px;
    color: #262626;
    padding: 6px 16px;
    min-height: 32px;
}

QPushButton:hover {
    color: #1890FF;
    border-color: #1890FF;
}

QPushButton:pressed {
    background-color: #F0F2F5;
}

QPushButton#primaryButton {
    background-color: #1890FF;
    border: 1px solid #1890FF;
    color: #FFFFFF;
    font-weight: 500;
}

QPushButton#primaryButton:hover {
    background-color: #40A9FF;
    border-color: #40A9FF;
    color: #FFFFFF;
}

QPushButton#primaryButton:pressed {
    background-color: #096DD9;
}

QPushButton:disabled,
QPushButton#primaryButton:disabled,
QPushButton#secondaryButton:disabled,
QPushButton#tableActionButton:disabled,
QPushButton#tableActionButtonDanger:disabled {
    background-color: #F5F5F5;
    border-color: #E8E8E8;
    color: #BFBFBF;
}

QPushButton#primaryButton:disabled {
    background-color: #F0F0F0;
    border-color: #E8E8E8;
    color: #BFBFBF;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    border: 1px solid #D9D9D9;
}

QPushButton#secondaryButton:hover {
    color: #1890FF;
    border-color: #1890FF;
}

QPushButton#tableActionButton {
    background-color: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 6px;
    color: #262626;
    font-size: 12px;
    font-weight: 500;
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
}

QPushButton#tableActionButton:hover {
    color: #1890FF;
    border-color: #1890FF;
    background-color: #F0F7FF;
}

QPushButton#tableActionButtonDanger {
    background-color: #FFF2F0;
    border: 1px solid #FFA39E;
    border-radius: 6px;
    color: #CF1322;
    font-size: 12px;
    font-weight: 500;
    height: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 12px;
}

QPushButton#tableActionButtonDanger:hover {
    color: #FFFFFF;
    border-color: #FF4D4F;
    background-color: #FF4D4F;
}

QPushButton#alertButton {
    background-color: #FFF2F0;
    border: 1px solid #FF7875;
    color: #CF1322;
    font-weight: 600;
    min-height: 36px;
    padding: 6px 20px;
}

QPushButton#alertButton:hover {
    background-color: #FF4D4F;
    border-color: #FF4D4F;
    color: #FFFFFF;
}

QPushButton#alertButton:pressed {
    background-color: #CF1322;
    border-color: #CF1322;
    color: #FFFFFF;
}

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QComboBox, QTextEdit {
    background-color: #FAFBFC;
    border: 1px solid #D9D9D9;
    border-radius: 8px;
    padding: 7px 10px;
    min-height: 22px;
    selection-background-color: #1890FF;
}

QPushButton#hostCombo {
    background-color: #F6FFED;
    border: 1px solid #95DE64;
    border-radius: 16px;
    color: #389E0D;
    font-weight: 600;
    padding: 6px 12px;
    min-height: 28px;
}

QPushButton#hostCombo:hover {
    background-color: #EFFFDB;
    border-color: #73D13D;
}

QPushButton#hostCombo:pressed {
    background-color: #D9F7BE;
    border-color: #52C41A;
}

QFrame#hostComboPopup {
    background: transparent;
    border: none;
}

QListWidget#hostComboList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#hostComboList::item {
    color: #262626;
    padding: 6px 10px;
    border-radius: 8px;
    min-height: 28px;
}

QListWidget#hostComboList::item:selected {
    background-color: #E6F4FF;
    color: #1890FF;
}

QListWidget#hostComboList::item:hover {
    background-color: #F5F7FA;
}

QSpinBox {
    padding-right: 4px;
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: #F5F5F5;
    border-left: 1px solid #D9D9D9;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #E6F4FF;
}

QLineEdit:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #1890FF;
    background-color: #FFFFFF;
}

QComboBox:focus {
    border: 1px solid #1890FF;
    background-color: #FFFFFF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E8ECF0;
    selection-background-color: #E6F4FF;
    selection-color: #1890FF;
}

/* ---- Tables ---- */
QTableWidget#incidentTable {
    background-color: #FFFFFF;
    border: none;
    gridline-color: #EEF2F7;
    alternate-background-color: #F7FAFD;
}

QWidget#incidentTableHeader {
    background-color: #EEF3F9;
    border-bottom: 1px solid #DDE6F0;
}

QFrame#incidentCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE6F0;
}

QTableWidget {
    background-color: #FFFFFF;
    border: none;
    gridline-color: #F0F0F0;
    alternate-background-color: #FAFBFC;
}

QTableWidget::item {
    padding: 4px 10px;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:selected {
    background-color: #E6F4FF;
    color: #262626;
}

QHeaderView::section {
    background-color: #F4F7FB;
    color: #5B6B7C;
    font-weight: 600;
    font-size: 12px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #E8ECF0;
}

QTableWidget#incidentTable QHeaderView::section {
    background-color: #E3EBF5;
    color: #3D5A80;
}

/* ---- Group / Form ---- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #262626;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #D9D9D9;
    background: #FFFFFF;
}

QCheckBox::indicator:checked {
    background: #1890FF;
    border-color: #1890FF;
}

/* ---- Status bar ---- */
QStatusBar {
    background: #FFFFFF;
    color: #8C8C8C;
    border-top: 1px solid #E8ECF0;
    font-size: 12px;
}

/* ---- Wizard ---- */
QWizard {
    background-color: #F0F2F5;
}

QWizard QWidget {
    background-color: #F0F2F5;
}

QWizardPage {
    background-color: #F0F2F5;
}

QWizard QLabel {
    color: #595959;
}

QScrollArea#wizardScroll {
    background: transparent;
    border: none;
}

QWidget#wizardPageBody {
    background: transparent;
}

QWizardPage QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E5EAF1;
    border-radius: 12px;
}

QTextEdit#wizardResultBox {
    background-color: #FFFFFF;
    border: 1px solid #E8ECF0;
    border-radius: 8px;
    padding: 10px 12px;
}

QWizardPage QCheckBox {
    padding: 4px 0;
    min-height: 28px;
}

QLabel#wizardSectionTitle {
    color: #1F2937;
    font-size: 15px;
    font-weight: 600;
}

QLabel#wizardSectionDesc {
    color: #6B7280;
    font-size: 12px;
}

QLabel#wizardFieldLabel {
    color: #475467;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding: 0;
}

QLabel#wizardFieldHint {
    color: #8C8C8C;
    font-size: 12px;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #F5F5F5;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #D9D9D9;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #BFBFBF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F5F5F5;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #D9D9D9;
    border-radius: 4px;
    min-width: 24px;
}

/* ---- Service summary strip ---- */
QLabel#serviceStripTitle {
    color: #262626;
    font-size: 13px;
    font-weight: 600;
    padding-right: 4px;
}

QLabel#serviceChip {
    color: #595959;
    background-color: #F5F7FA;
    border: 1px solid #E8ECF0;
    border-radius: 14px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel#serviceChip[accent="success"] {
    color: #389E0D;
    background-color: #F6FFED;
    border-color: #B7EB8F;
}

QLabel#serviceChip[accent="danger"] {
    color: #CF1322;
    background-color: #FFF2F0;
    border-color: #FFCCC7;
}

QPushButton#alertButtonCompact {
    background: transparent;
    border: none;
    color: #CF1322;
    font-weight: 600;
    font-size: 12px;
    min-height: 28px;
    max-height: 28px;
    padding: 0 8px;
}

QPushButton#alertButtonCompact:hover {
    color: #FF4D4F;
    background: transparent;
    border: none;
}

/* ---- Host metrics bar (compact strip) ---- */
QLabel#metricsDot {
    font-size: 10px;
}

QLabel#metricsDot[accent="cpu"] {
    color: #1890FF;
}

QLabel#metricsDot[accent="mem"] {
    color: #52C41A;
}

QLabel#metricsDot[accent="disk"] {
    color: #722ED1;
}

QLabel#metricsCellTitle {
    color: #8C8C8C;
    font-size: 11px;
}

QLabel#metricsCellValue {
    color: #262626;
    font-size: 13px;
    font-weight: 600;
}

QLabel#metricsCellValue[level="warn"] {
    color: #D48806;
}

QLabel#metricsCellValue[level="danger"] {
    color: #CF1322;
}

QLabel#metricsCellHint {
    color: #8C8C8C;
    font-size: 10px;
    max-width: 140px;
}

QLabel#metricsStatus {
    color: #CF1322;
    font-size: 11px;
}

QPushButton#metricsToggle {
    background: transparent;
    border: none;
    color: #1890FF;
    font-size: 11px;
    padding: 0 2px;
    min-height: 20px;
}

QPushButton#metricsToggle:hover {
    color: #40A9FF;
}

QPushButton#metricsToggle:disabled {
    color: #BFBFBF;
}

QProgressBar#metricsBar {
    background-color: #F0F2F5;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}

QProgressBar#metricsBar::chunk {
    background-color: #52C41A;
    border-radius: 4px;
}

QProgressBar#metricsBar[accent="cpu"]::chunk {
    background-color: #1890FF;
}

QProgressBar#metricsBar[accent="mem"]::chunk {
    background-color: #52C41A;
}

QProgressBar#metricsBar[accent="disk"]::chunk {
    background-color: #722ED1;
}

QProgressBar#metricsBar[level="warn"]::chunk {
    background-color: #FAAD14;
}

QProgressBar#metricsBar[level="danger"]::chunk {
    background-color: #FF4D4F;
}

QTabWidget#metricsTabs::pane {
    border: 1px solid #E8ECF0;
    border-radius: 8px;
    top: -1px;
    background: #FFFFFF;
}

QTabWidget#metricsTabs QTabBar::tab {
    background: transparent;
    color: #8C8C8C;
    padding: 6px 12px;
    margin-right: 2px;
    border: none;
}

QTabWidget#metricsTabs QTabBar::tab:selected {
    color: #1890FF;
    font-weight: 600;
    border-bottom: 2px solid #1890FF;
}

QWidget#caseTableHeader {
    background-color: #EEF3F9;
    border-bottom: 1px solid #DDE6F0;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #F0F2F5;
    text-align: center;
    color: #595959;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #1890FF;
    border-radius: 6px;
}

